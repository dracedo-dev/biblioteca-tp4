<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-arrow-left-right"></i> Gestión de Préstamos</h2>
    <a href="/prestamos/nuevo" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Nuevo Préstamo</a>
</div>

<!-- Barra de Búsqueda (Colocar sobre la tabla) -->
<form action="" method="GET" class="d-flex gap-2 mb-3 col-md-5">
    <input type="text" name="buscar" value="<%= buscar %>" class="form-control" placeholder="Buscar...">
    <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-search"></i></button>
    <% if (buscar) { %>
        <a href="?" class="btn btn-outline-danger">Limpiar</a>
    <% } %>
</form>

<div class="card shadow-sm">
    <div class="card-body">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Socio</th>
                    <th>Libro</th>
                    <th>Fecha Préstamo</th>
                    <th>Devolución Prevista</th>
                    <th>Devolución Real</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                <% if (prestamos.length === 0) { %>
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">No hay préstamos registrados.</td>
                    </tr>
                <% } else { %>
                    <% prestamos.forEach(p => { %>
                        <tr>
                            <td><strong><%= p.socio_nombre %> <%= p.socio_apellido %></strong> <br><small class="text-muted">DNI: <%= p.socio_dni %></small></td>
                            <td><strong><%= p.libro_titulo || 'Sin especificar' %></strong></td>
                            <td><%= new Date(p.fecha_prestamo).toLocaleDateString('es-AR') %></td>
                            <td><%= new Date(p.fecha_vencimiento).toLocaleDateString('es-AR') %></td>
                            <td><%= p.fecha_devolucion ? new Date(p.fecha_devolucion).toLocaleDateString('es-AR') : '-' %></td>
                            <td>
                                <% if (p.estado === 'Devuelto') { %>
                                    <span class="badge bg-success">Devuelto</span>
                                <% } else if (p.estado === 'Vencido') { %>
                                    <span class="badge bg-danger">Vencido</span>
                                <% } else { %>
                                    <span class="badge bg-primary">Activo</span>
                                <% } %>
                            </td>
                            <td class="text-end">
                                <% if (p.estado === 'Activo') { %>
                                    <form action="/prestamos/devolver/<%= p.id_prestamo %>" method="POST" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-success" title="Marcar como devuelto">
                                            <i class="bi bi-check-circle"></i> Devolver
                                        </button>
                                    </form>
                                <% } %>
                            </td>
                        </tr>
                    <% }); %>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<!-- Paginación (Colocar debajo de la tabla) -->
<% if (totalPaginas > 1) { %>
    <nav class="mt-4">
        <ul class="pagination justify-content-center mb-0">
            <li class="page-item <%= paginaActual === 1 ? 'disabled' : '' %>">
                <a class="page-link" href="?buscar=<%= buscar %>&pagina=<%= paginaActual - 1 %>">Anterior</a>
            </li>
            <% for (let i = 1; i <= totalPaginas; i++) { %>
                <li class="page-item <%= paginaActual === i ? 'active' : '' %>">
                    <a class="page-link" href="?buscar=<%= buscar %>&pagina=<%= i %>"><%= i %></a>
                </li>
            <% } %>
            <li class="page-item <%= paginaActual === totalPaginas ? 'disabled' : '' %>">
                <a class="page-link" href="?buscar=<%= buscar %>&pagina=<%= paginaActual + 1 %>">Siguiente</a>
            </li>
        </ul>
    </nav>
<% } %>

<%- include('../partials/footer') %>