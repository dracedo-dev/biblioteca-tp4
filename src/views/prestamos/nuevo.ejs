<%- include('../partials/header') %>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><i class="bi bi-journal-arrow-up"></i> Registrar Nuevo Préstamo</h4>
            </div>
            <div class="card-body">
                <% if (error) { %>
                    <div class="alert alert-danger"><%= error %></div>
                <% } %>

                <form action="/prestamos/nuevo" method="POST">
                    <div class="mb-3">
                        <label class="form-label">Socio Solicitante</label>
                        <select name="id_socio" class="form-select" required>
                            <option value="">-- Seleccionar Socio --</option>
                            <% socios.forEach(socio => { %>
                                <option value="<%= socio.id_socio %>"><%= socio.apellido %>, <%= socio.nombre %> (DNI: <%= socio.dni %>)</option>
                            <% }); %>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Libro a Prestar</label>
                        <select name="id_libro" class="form-select" required>
                            <option value="">-- Seleccionar Libro --</option>
                            <% libros.forEach(libro => { %>
                                <option value="<%= libro.id_libro %>"><%= libro.titulo %></option>
                            <% }); %>
                        </select>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Fecha de Préstamo</label>
                            <input type="date" name="fecha_prestamo" class="form-control" required id="fecha_prestamo">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Fecha de Devolución Prevista</label>
                            <input type="date" name="fecha_devolucion_esperada" class="form-control" required id="fecha_devolucion_esperada">
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a href="/prestamos" class="btn btn-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary">Registrar Préstamo</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    // Setear la fecha de hoy por defecto en la fecha de préstamo
    document.getElementById('fecha_prestamo').valueAsDate = new Date();
</script>

<%- include('../partials/footer') %>