<%- include('../partials/header') %>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><i class="bi bi-plus-circle"></i> Registrar Nuevo Préstamo</h4>
            </div>
            <div class="card-body">
                <% if (error) { %>
                    <div class="alert alert-danger"><%= error %></div>
                <% } %>

                <form action="/prestamos/nuevo" method="POST">
                    <!-- Socio -->
                    <div class="mb-3">
                        <label for="id_socio" class="form-label">Socio Solicitante</label>
                        <select name="id_socio" id="id_socio" class="form-select" required>
                            <option value="">-- Seleccionar Socio --</option>
                            <% socios.forEach(socio => { %>
                                <option value="<%= socio.id_socio %>">
                                    <%= socio.apellido %>, <%= socio.nombre %> (DNI: <%= socio.dni %>)
                                </option>
                            <% }); %>
                        </select>
                    </div>

                    <!-- Libro -->
                    <div class="mb-3">
                        <label for="id_libro" class="form-label">Libro a Prestar</label>
                        <select name="id_libro" id="id_libro" class="form-select">
                            <option value="">-- Seleccionar Libro --</option>
                            <% libros.forEach(l => { %>
                                <option value="<%= l.id_libro %>"><%= l.titulo %></option>
                            <% }); %>
                        </select>
                    </div>

                    <!-- Fechas -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="fecha_prestamo" class="form-label">Fecha Préstamo</label>
                            <input type="date" name="fecha_prestamo" id="fecha_prestamo" class="form-control" required>
                        </div>
                        <div class="col-md-6">
                            <label for="fecha_vencimiento" class="form-label">Fecha Vencimiento / Dev. Prevista</label>
                            <input type="date" name="fecha_vencimiento" id="fecha_vencimiento" class="form-control" required>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a href="/prestamos" class="btn btn-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-success">Guardar Préstamo</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>