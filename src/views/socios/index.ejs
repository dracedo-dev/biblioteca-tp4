<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-people"></i> Gestión de Socios</h2>
    <a href="/socios/nuevo" class="btn btn-primary"><i class="bi bi-person-plus"></i> Nuevo Socio</a>
</div>

<!-- Barra de Búsqueda (Colocar sobre la tabla) -->
<form action="" method="GET" class="d-flex gap-2 mb-3 col-md-5">
    <input type="text" name="buscar" value="<%= buscar %>" class="form-control" placeholder="Buscar...">
    <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-search"></i></button>
    <% if (buscar) { %>
        <a href="?" class="btn btn-outline-danger">Limpiar</a>
    <% } %>
</form>

<div class="card shadow-sm">
    <div class="card-body">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>DNI</th>
                    <th>Nombre Completo</th>
                    <th>Email</th>
                    <th>Teléfono</th>
                    <th>Dirección</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                <% if (socios.length === 0) { %>
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">No hay socios registrados.</td>
                    </tr>
                <% } else { %>
                    <% socios.forEach(socio => { %>
                        <tr>
                            <td><strong><%= socio.dni %></strong></td>
                            <td><%= socio.nombre %> <%= socio.apellido %></td>
                            <td><%= socio.email %></td>
                            <td><%= socio.telefono || '-' %></td>
                            <td><%= socio.direccion || '-' %></td>
                            <td class="text-end">
                                <a href="/socios/editar/<%= socio.id_socio %>" class="btn btn-sm btn-outline-warning me-1">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form action="/socios/eliminar/<%= socio.id_socio %>" method="POST" class="d-inline" onsubmit="return confirm('¿Seguro que querés eliminar este socio?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    <% }); %>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<!-- Paginación (Colocar debajo de la tabla) -->
<% if (totalPaginas > 1) { %>
    <nav class="mt-4">
        <ul class="pagination justify-content-center mb-0">
            <li class="page-item <%= paginaActual === 1 ? 'disabled' : '' %>">
                <a class="page-link" href="?buscar=<%= buscar %>&pagina=<%= paginaActual - 1 %>">Anterior</a>
            </li>
            <% for (let i = 1; i <= totalPaginas; i++) { %>
                <li class="page-item <%= paginaActual === i ? 'active' : '' %>">
                    <a class="page-link" href="?buscar=<%= buscar %>&pagina=<%= i %>"><%= i %></a>
                </li>
            <% } %>
            <li class="page-item <%= paginaActual === totalPaginas ? 'disabled' : '' %>">
                <a class="page-link" href="?buscar=<%= buscar %>&pagina=<%= paginaActual + 1 %>">Siguiente</a>
            </li>
        </ul>
    </nav>
<% } %>

<%- include('../partials/footer') %>