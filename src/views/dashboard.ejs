<%- include('partials/header') %>

<div class="row mb-4">
    <div class="col-12">
        <div class="p-4 bg-white rounded shadow-sm border">
            <h2 class="mb-2"><i class="bi bi-speedometer2"></i> Panel de Control</h2>
            <p class="text-muted mb-0">Bienvenido/a al Sistema de Gestión de Biblioteca, <strong><%= usuario.nombre || usuario.email || 'Usuario' %></strong>.</p>
        </div>
    </div>
</div>

<!-- Accesos Rápidos -->
<div class="row g-3">
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0 bg-primary text-white">
            <div class="card-body d-flex flex-column justify-content-between p-4">
                <div>
                    <i class="bi bi-people fs-1"></i>
                    <h4 class="mt-2">Socios</h4>
                    <p class="mb-0 text-white-50">Gestioná los socios registrados y sus datos de contacto.</p>
                </div>
                <a href="/socios" class="btn btn-light text-primary fw-bold mt-3">Ir a Socios <i class="bi bi-arrow-right"></i></a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0 bg-success text-white">
            <div class="card-body d-flex flex-column justify-content-between p-4">
                <div>
                    <i class="bi bi-journal-bookmark fs-1"></i>
                    <h4 class="mt-2">Libros</h4>
                    <p class="mb-0 text-white-50">Administrá el catálogo de libros, sus categorías, autores y editoriales.</p>
                </div>
                <a href="/libros" class="btn btn-light text-success fw-bold mt-3">Ir a Libros <i class="bi bi-arrow-right"></i></a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0 bg-dark text-white">
            <div class="card-body d-flex flex-column justify-content-between p-4">
                <div>
                    <i class="bi bi-arrow-left-right fs-1"></i>
                    <h4 class="mt-2">Préstamos</h4>
                    <p class="mb-0 text-white-50">Controlá las devoluciones y el registro de nuevos préstamos.</p>
                </div>
                <a href="/prestamos" class="btn btn-outline-light fw-bold mt-3">Ir a Préstamos <i class="bi bi-arrow-right"></i></a>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>