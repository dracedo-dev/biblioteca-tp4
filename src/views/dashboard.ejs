<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel Principal - Biblioteca</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

    <!-- Navbar simple -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" href="/dashboard">📚 Gestión de Biblioteca</a>
            <div class="d-flex align-items-center text-white">
                <span class="me-3">Hola, <strong><%= usuario ? usuario.nombre : 'Usuario' %></strong></span>
                <a href="/logout" class="btn btn-outline-light btn-sm">Cerrar Sesión</a>
            </div>
        </div>
    </nav>

    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="p-5 bg-light rounded-3 border">
                    <h1 class="display-6">Bienvenido al Sistema de Gestión</h1>
                    <p class="lead">Desde aquí podés administrar los módulos de socios, libros, ejemplares y préstamos.</p>
                </div>
            </div>
        </div>
    </div>

</body>
</html>