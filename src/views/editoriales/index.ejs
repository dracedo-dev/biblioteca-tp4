<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-building"></i> Gestión de Editoriales</h2>
</div>

<!-- Alerta de Error de Integridad vía Query URL -->
<% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>

<!-- Buscador y Formulario de Registro -->
<div class="row mb-4">
    <div class="col-md-6 mb-2">
        <form action="/editoriales" method="GET" class="d-flex gap-2">
            <input type="text" name="buscar" value="<%= buscar %>" class="form-control" placeholder="Buscar editorial...">
            <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-search"></i></button>
            <% if (buscar) { %>
                <a href="/editoriales" class="btn btn-outline-danger">Limpiar</a>
            <% } %>
        </form>
    </div>
    <div class="col-md-6">
        <form action="/editoriales/nuevo" method="POST" class="d-flex gap-2">
            <input type="text" name="nombre" class="form-control" placeholder="Nueva editorial..." required>
            <button type="submit" class="btn btn-primary text-nowrap"><i class="bi bi-plus-circle"></i> Agregar</button>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                <% if (editoriales.length === 0) { %>
                    <tr>
                        <td colspan="3" class="text-center py-4 text-muted">No se encontraron editoriales.</td>
                    </tr>
                <% } else { %>
                    <% editoriales.forEach(e => { %>
                        <tr>
                            <td><%= e.id_editorial %></td>
                            <td><strong><%= e.nombre %></strong></td>
                            <td class="text-end">
                                <a href="/editoriales/editar/<%= e.id_editorial %>" class="btn btn-sm btn-outline-warning"><i class="bi bi-pencil"></i></a>
                                <form action="/editoriales/eliminar/<%= e.id_editorial %>" method="POST" class="d-inline" onsubmit="return confirm('¿Eliminar editorial?')">
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    <% }); %>
                <% } %>
            </tbody>
        </table>

        <!-- Paginación -->
        <% if (totalPaginas > 1) { %>
            <nav class="mt-4">
                <ul class="pagination justify-content-center mb-0">
                    <li class="page-item <%= paginaActual === 1 ? 'disabled' : '' %>">
                        <a class="page-link" href="/editoriales?buscar=<%= buscar %>&pagina=<%= paginaActual - 1 %>">Anterior</a>
                    </li>
                    <% for (let i = 1; i <= totalPaginas; i++) { %>
                        <li class="page-item <%= paginaActual === i ? 'active' : '' %>">
                            <a class="page-link" href="/editoriales?buscar=<%= buscar %>&pagina=<%= i %>"><%= i %></a>
                        </li>
                    <% } %>
                    <li class="page-item <%= paginaActual === totalPaginas ? 'disabled' : '' %>">
                        <a class="page-link" href="/editoriales?buscar=<%= buscar %>&pagina=<%= paginaActual + 1 %>">Siguiente</a>
                    </li>
                </ul>
            </nav>
        <% } %>
    </div>
</div>

<%- include('../partials/footer') %>