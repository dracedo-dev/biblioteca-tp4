<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bg-building"></i> Gestión de Editoriales</h2>
</div>

<% if (error) { %>
    <div class="alert alert-danger"><%= error %></div>
<% } %>

<div class="row">
    <!-- Formulario para agregar editorial -->
    <div class="col-md-4 mb-4">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="card-title mb-0"><i class="bi bi-plus-circle"></i> Nueva Editorial</h5>
            </div>
            <div class="card-body">
                <form action="/editoriales/nuevo" method="POST">
                    <div class="mb-3">
                        <label class="form-label">Nombre de la Editorial</label>
                        <input type="text" name="nombre" class="form-control" required placeholder="Ej: Editorial Planeta, Penguin">
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Guardar Editorial</button>
                </form>
            </div>
        </div>
    </div>

    <!-- Tabla de editoriales -->
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (editoriales.length === 0) { %>
                            <tr>
                                <td colspan="3" class="text-center py-4 text-muted">No hay editoriales registradas.</td>
                            </tr>
                        <% } else { %>
                            <% editoriales.forEach(ed => { %>
                                <tr>
                                    <td><strong><%= ed.id_editorial %></strong></td>
                                    <td><%= ed.nombre %></td>
                                    <td class="text-end">
                                        <form action="/editoriales/eliminar/<%= ed.id_editorial %>" method="POST" class="d-inline" onsubmit="return confirm('¿Seguro que querés eliminar esta editorial?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>