<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-journal-bookmark"></i> Gestión de Libros</h2>
    <a href="/libros/nuevo" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Nuevo Libro</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Título</th>
                    <th>ISBN</th>
                    <th>Autor</th>
                    <th>Categoría</th>
                    <th>Editorial</th>
                    <th>Año</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                <% if (libros.length === 0) { %>
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">No hay libros registrados.</td>
                    </tr>
                <% } else { %>
                    <% libros.forEach(libro => { %>
                        <tr>
                            <td><strong><%= libro.titulo %></strong></td>
                            <td><%= libro.isbn || '-' %></td>
                            <td><%= libro.autor_nombre ? libro.autor_nombre + ' ' + libro.autor_apellido : '-' %></td>
                            <td><span class="badge bg-info text-dark"><%= libro.categoria || 'Sin categoría' %></span></td>
                            <td><%= libro.editorial || '-' %></td>
                            <td><%= libro.anio_publicacion || '-' %></td>
                            <td class="text-end">
                                <form action="/libros/eliminar/<%= libro.id_libro %>" method="POST" class="d-inline" onsubmit="return confirm('¿Seguro que querés eliminar este libro?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    <% }); %>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<%- include('../partials/footer') %>