<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-journal-bookmark"></i> Gestión de Libros</h2>
    <a href="/libros/nuevo" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Nuevo Libro</a>
</div>

<!-- Barra de Búsqueda (Colocar sobre la tabla) -->
<form action="" method="GET" class="d-flex gap-2 mb-3 col-md-5">
    <input type="text" name="buscar" value="<%= buscar %>" class="form-control" placeholder="Buscar...">
    <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-search"></i></button>
    <% if (buscar) { %>
        <a href="?" class="btn btn-outline-danger">Limpiar</a>
    <% } %>
</form>

<div class="card shadow-sm">
    <div class="card-body">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Título</th>
                    <th>ISBN</th>
                    <th>Autor</th>
                    <th>Categoría</th>
                    <th>Editorial</th>
                    <th>Año</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                <% if (libros.length === 0) { %>
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">No hay libros registrados.</td>
                    </tr>
                <% } else { %>
                    <% libros.forEach(libro => { %>
                        <tr>
                            <td><strong><%= libro.titulo %></strong></td>
                            <td><%= libro.isbn || '-' %></td>
                            <td><%= libro.autor_nombre ? libro.autor_nombre + ' ' + libro.autor_apellido : '-' %></td>
                            <td><span class="badge bg-info text-dark"><%= libro.categoria || 'Sin categoría' %></span></td>
                            <td><%= libro.editorial || '-' %></td>
                            <td><%= libro.anio_publicacion || '-' %></td>
                            <td class="text-end">
                                <form action="/libros/eliminar/<%= libro.id_libro %>" method="POST" class="d-inline" onsubmit="return confirm('¿Seguro que querés eliminar este libro?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    <% }); %>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<!-- Paginación (Colocar debajo de la tabla) -->
<% if (totalPaginas > 1) { %>
    <nav class="mt-4">
        <ul class="pagination justify-content-center mb-0">
            <li class="page-item <%= paginaActual === 1 ? 'disabled' : '' %>">
                <a class="page-link" href="?buscar=<%= buscar %>&pagina=<%= paginaActual - 1 %>">Anterior</a>
            </li>
            <% for (let i = 1; i <= totalPaginas; i++) { %>
                <li class="page-item <%= paginaActual === i ? 'active' : '' %>">
                    <a class="page-link" href="?buscar=<%= buscar %>&pagina=<%= i %>"><%= i %></a>
                </li>
            <% } %>
            <li class="page-item <%= paginaActual === totalPaginas ? 'disabled' : '' %>">
                <a class="page-link" href="?buscar=<%= buscar %>&pagina=<%= paginaActual + 1 %>">Siguiente</a>
            </li>
        </ul>
    </nav>
<% } %>

<%- include('../partials/footer') %>