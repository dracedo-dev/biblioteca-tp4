<%- include('../partials/header') %>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-warning text-dark">
                <h4 class="mb-0"><i class="bi bi-pencil-square"></i> Editar Libro</h4>
            </div>
            <div class="card-body">
                <% if (error) { %>
                    <div class="alert alert-danger"><%= error %></div>
                <% } %>

                <form action="/libros/editar/<%= libro.id_libro %>" method="POST">
                    <div class="row mb-3">
                        <div class="col-md-8">
                            <label for="titulo" class="form-label">Título del Libro</label>
                            <input type="text" name="titulo" id="titulo" class="form-control" value="<%= libro.titulo %>" required>
                        </div>
                        <div class="col-md-4">
                            <label for="isbn" class="form-label">ISBN</label>
                            <input type="text" name="isbn" id="isbn" class="form-control" value="<%= libro.isbn %>" required>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label for="id_categoria" class="form-label">Categoría</label>
                            <select name="id_categoria" id="id_categoria" class="form-select" required>
                                <% categorias.forEach(c => { %>
                                    <option value="<%= c.id_categoria %>" <%= c.id_categoria === libro.id_categoria ? 'selected' : '' %>><%= c.nombre %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="id_autor" class="form-label">Autor</label>
                            <select name="id_autor" id="id_autor" class="form-select" required>
                                <% autores.forEach(a => { %>
                                    <option value="<%= a.id_autor %>" <%= a.id_autor === libro.id_autor ? 'selected' : '' %>><%= a.nombre %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="id_editorial" class="form-label">Editorial</label>
                            <select name="id_editorial" id="id_editorial" class="form-select" required>
                                <% editoriales.forEach(e => { %>
                                    <option value="<%= e.id_editorial %>" <%= e.id_editorial === libro.id_editorial ? 'selected' : '' %>><%= e.nombre %></option>
                                <% }) %>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="anio_publicacion" class="form-label">Año de Publicación</label>
                        <input type="number" name="anio_publicacion" id="anio_publicacion" class="form-control" value="<%= libro.anio_publicacion %>" required>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a href="/libros" class="btn btn-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-warning">Actualizar Libro</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>