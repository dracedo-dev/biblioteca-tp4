<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-tags"></i> Gestión de Categorías</h2>
</div>

<% if (error) { %>
    <div class="alert alert-danger"><%= error %></div>
<% } %>

<form action="/categorias" method="GET" class="d-flex gap-2 mb-3">
        <input type="text" name="buscar" value="<%= buscar %>" class="form-control" placeholder="Buscar categoría...">
        <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-search"></i></button>
        <% if (buscar) { %>
            <a href="/categorias" class="btn btn-outline-danger">Limpiar</a>
        <% } %>
    </form>

<div class="row">
    <!-- Formulario para agregar categoría -->
    <div class="col-md-4 mb-4">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="card-title mb-0"><i class="bi bi-plus-circle"></i> Nueva Categoría</h5>
            </div>
            <div class="card-body">
                <form action="/categorias/nuevo" method="POST">
                    <div class="mb-3">
                        <label class="form-label">Nombre</label>
                        <input type="text" name="nombre" class="form-control" required placeholder="Ej: Novela, Ciencia Ficción">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Descripción</label>
                        <textarea name="descripcion" class="form-control" rows="3" placeholder="Opcional"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Guardar Categoría</button>
                </form>
            </div>
        </div>
    </div>
    
    <!-- Tabla con el listado de categorías -->
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Descripción</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (categorias.length === 0) { %>
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">No hay categorías registradas.</td>
                            </tr>
                        <% } else { %>
                            <% categorias.forEach(cat => { %>
                                <tr>
                                    <td><strong><%= cat.id_categoria %></strong></td>
                                    <td><span class="badge bg-info text-dark"><%= cat.nombre %></span></td>
                                    <td><%= cat.descripcion || '-' %></td>
                                    <td class="text-end">
                                        <a href="/categorias/editar/<%= cat.id_categoria %>" class="btn btn-sm btn-outline-warning">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form action="/categorias/eliminar/<%= cat.id_categoria %>" method="POST" class="d-inline" onsubmit="return confirm('¿Seguro que querés eliminar esta categoría?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>