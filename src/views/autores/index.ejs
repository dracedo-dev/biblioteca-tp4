<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-person-badge"></i> Gestión de Autores</h2>
</div>

<% if (error) { %>
    <div class="alert alert-danger"><%= error %></div>
<% } %>

<div class="row">
    <!-- Formulario para agregar autor -->
    <div class="col-md-4 mb-4">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="card-title mb-0"><i class="bi bi-plus-circle"></i> Nuevo Autor</h5>
            </div>
            <div class="card-body">
                <form action="/autores/nuevo" method="POST">
                    <div class="mb-3">
                        <label class="form-label">Nombre</label>
                        <input type="text" name="nombre" class="form-control" required placeholder="Ej: Gabriel">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Apellido</label>
                        <input type="text" name="apellido" class="form-control" required placeholder="Ej: García Márquez">
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Guardar Autor</button>
                </form>
            </div>
        </div>
    </div>

    <!-- Tabla de autores -->
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Nombre Completo</th>
                            <th>Nacionalidad</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (autores.length === 0) { %>
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">No hay autores registrados.</td>
                            </tr>
                        <% } else { %>
                            <% autores.forEach(autor => { %>
                                <tr>
                                    <td><strong><%= autor.id_autor %></strong></td>
                                    <td><%= autor.nombre %> <%= autor.apellido %></td>
                                    <td><%= autor.nacionalidad || '-' %></td>
                                    <td class="text-end">
                                        <form action="/autores/eliminar/<%= autor.id_autor %>" method="POST" class="d-inline" onsubmit="return confirm('¿Seguro que querés eliminar este autor?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>